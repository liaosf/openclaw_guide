---
import NotificationBar from '../components/NotificationBar.astro';
import LandingHeader from '../components/LandingHeader.astro';
import LandingFooter from '../components/LandingFooter.astro';
import '../styles/tailwind.css';
---

<html lang="zh-CN" class="scroll-smooth">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>OpenClaw 101 — 从零开始，7天掌握你的AI私人助理</title>
    <meta name="description" content="开源免费 · 收录 35+ 篇教程资源，从零开始，7天掌握你的 AI 私人助理。" />
</head>
<body class="bg-gray-50 text-gray-900 font-sans antialiased">
    <NotificationBar />
    <LandingHeader />

    <main>
        <!-- Hero Section -->
        <section class="relative bg-white pt-20 pb-32 overflow-hidden">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
                <h1 class="text-4xl tracking-tight font-extrabold text-gray-900 sm:text-5xl md:text-6xl">
                    <span class="block">从零开始，7天掌握</span>
                    <span class="block text-indigo-600">你的 AI 私人助理</span>
                </h1>
                <p class="mt-3 max-w-md mx-auto text-base text-gray-500 sm:text-lg md:mt-5 md:text-xl md:max-w-3xl">
                    OpenClaw 101 是一个开源 AI 助理平台指南，收录 35+ 篇教程资源。让你拥有一个 24/7 在线的私人 AI 助理。
                </p>
                <div class="mt-10 max-w-sm mx-auto sm:max-w-none sm:flex sm:justify-center">
                    <div class="space-y-4 sm:space-y-0 sm:mx-auto sm:inline-grid sm:grid-cols-2 sm:gap-5">
                        <a href="/guides/day1" class="flex items-center justify-center px-8 py-3 border border-transparent text-base font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 md:py-4 md:text-lg md:px-10">
                            开始 7 天挑战
                        </a>
                        <a href="https://github.com/openclaw/openclaw" class="flex items-center justify-center px-8 py-3 border border-transparent text-base font-medium rounded-md text-indigo-700 bg-indigo-100 hover:bg-indigo-200 md:py-4 md:text-lg md:px-10">
                            GitHub 源码
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <!-- About Section -->
        <section id="about" class="py-20 bg-gray-50">
           <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
               <div class="lg:text-center">
                   <h2 class="text-base text-indigo-600 font-semibold tracking-wide uppercase">关于 OpenClaw</h2>
                   <p class="mt-2 text-3xl leading-8 font-extrabold tracking-tight text-gray-900 sm:text-4xl">
                       什么是 OpenClaw？
                   </p>
                   <p class="mt-4 max-w-2xl text-xl text-gray-500 lg:mx-auto">
                       OpenClaw 是一个开源 AI 助理平台，让你拥有一个 24/7 在线的私人 AI 助理。它能理解你、帮助你、为你执行任务。
                   </p>
               </div>
           </div>
        </section>

        <!-- Features Section -->
        <section id="features" class="py-20 bg-white">
           <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="lg:text-center mb-16">
                    <h2 class="text-base text-indigo-600 font-semibold tracking-wide uppercase">核心特性</h2>
                    <p class="mt-2 text-3xl leading-8 font-extrabold tracking-tight text-gray-900 sm:text-4xl">
                        为什么选择 OpenClaw？
                    </p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
                    <div class="p-6 bg-gray-50 rounded-lg">
                        <div class="w-12 h-12 bg-indigo-100 rounded-md flex items-center justify-center text-indigo-600 mb-4">
                            🧠
                        </div>
                        <h3 class="text-lg font-medium text-gray-900">全平台接入</h3>
                        <p class="mt-2 text-gray-500">Telegram、Discord、WhatsApp、Signal 等多平台无缝连接，随时随地与你的AI助理对话。</p>
                    </div>
                    <div class="p-6 bg-gray-50 rounded-lg">
                        <div class="w-12 h-12 bg-indigo-100 rounded-md flex items-center justify-center text-indigo-600 mb-4">
                            ⚡
                        </div>
                        <h3 class="text-lg font-medium text-gray-900">技能扩展</h3>
                        <p class="mt-2 text-gray-500">1000+ 社区技能，从天气查询到代码生成，一键安装即用。</p>
                    </div>
                    <div class="p-6 bg-gray-50 rounded-lg">
                        <div class="w-12 h-12 bg-indigo-100 rounded-md flex items-center justify-center text-indigo-600 mb-4">
                            🔒
                        </div>
                        <h3 class="text-lg font-medium text-gray-900">数据自主</h3>
                        <p class="mt-2 text-gray-500">完全自托管，数据存储在你自己的服务器上，隐私和安全尽在掌握。</p>
                    </div>
                </div>
           </div>
        </section>

         <!-- Learning Path Section -->
        <section id="learning-path" class="py-20 bg-indigo-900 text-white">
           <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
               <div class="lg:text-center mb-12">
                   <h2 class="text-base text-indigo-300 font-semibold tracking-wide uppercase">学习路径</h2>
                   <p class="mt-2 text-3xl leading-8 font-extrabold tracking-tight text-white sm:text-4xl">
                       7天从入门到进阶
                   </p>
                   <p class="mt-4 max-w-2xl text-xl text-indigo-200 lg:mx-auto">
                       每天一个主题，循序渐进掌握 OpenClaw 的全部能力。
                   </p>
               </div>

               <div class="grid grid-cols-1 md:grid-cols-4 gap-6 text-center">
                    <!-- Day Items -->
                    {[1, 2, 3, 4, 5, 6, 7].map(day => (
                        <div class="bg-indigo-800 p-6 rounded-lg hover:bg-indigo-700 transition duration-300">
                            <span class="text-4xl font-bold block mb-2">Day {day}</span>
                            <span class="text-indigo-200">主题学习</span>
                        </div>
                    ))}
                    <div class="bg-indigo-600 p-6 rounded-lg flex items-center justify-center cursor-pointer hover:bg-indigo-500">
                        <a href="/guides/day1" class="font-bold text-lg">开始旅程 &rarr;</a>
                    </div>
               </div>
           </div>
        </section>

         <!-- Skills Section -->
        <section id="skills" class="py-20 bg-white">
           <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
               <div class="lg:text-center mb-16">
                   <h2 class="text-base text-indigo-600 font-semibold tracking-wide uppercase">生态系统</h2>
                   <p class="mt-2 text-3xl leading-8 font-extrabold tracking-tight text-gray-900 sm:text-4xl">
                       精选技能推荐
                   </p>
                   <p class="mt-4 max-w-2xl text-xl text-gray-500 lg:mx-auto">
                       按场景分类的 AI 技能，让你的助理覆盖工作与生活的方方面面。
                   </p>
               </div>

               <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
                   <div class="border border-gray-200 rounded-lg p-6">
                       <h4 class="font-bold text-lg mb-4">📧 效率工具</h4>
                       <ul class="space-y-2 text-gray-600">
                           <li>Gmail 管理</li>
                           <li>日历提醒</li>
                           <li>TODO 追踪</li>
                           <li>文件整理</li>
                       </ul>
                   </div>
                   <div class="border border-gray-200 rounded-lg p-6">
                       <h4 class="font-bold text-lg mb-4">🔍 SEO & 营销</h4>
                       <ul class="space-y-2 text-gray-600">
                           <li>Search Console</li>
                           <li>GA4 分析</li>
                           <li>关键词研究</li>
                           <li>排名追踪</li>
                       </ul>
                   </div>
                   <div class="border border-gray-200 rounded-lg p-6">
                       <h4 class="font-bold text-lg mb-4">💻 开发工具</h4>
                       <ul class="space-y-2 text-gray-600">
                           <li>GitHub 集成</li>
                           <li>代码 Agent</li>
                           <li>CI/CD 监控</li>
                       </ul>
                   </div>
                    <div class="border border-gray-200 rounded-lg p-6">
                       <h4 class="font-bold text-lg mb-4">🎨 内容创作</h4>
                       <ul class="space-y-2 text-gray-600">
                           <li>公众号策略</li>
                           <li>社交媒体管理</li>
                           <li>视频制作</li>
                       </ul>
                   </div>
               </div>
           </div>
        </section>

         <!-- Resources Section -->
        <section id="resources" class="py-20 bg-gray-50">
           <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
               <div class="lg:text-center mb-16">
                   <h2 class="text-base text-indigo-600 font-semibold tracking-wide uppercase">优质资源</h2>
                   <p class="mt-2 text-3xl leading-8 font-extrabold tracking-tight text-gray-900 sm:text-4xl">
                       全网精选收录
                   </p>
               </div>

               <div class="bg-white rounded-lg shadow-xl overflow-hidden">
                   <div class="p-8 grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
                       <div>
                           <span class="block text-4xl font-bold text-indigo-600">35+</span>
                           <span class="block mt-2 text-gray-500">篇精选教程</span>
                       </div>
                       <div>
                           <span class="block text-4xl font-bold text-indigo-600">15</span>
                           <span class="block mt-2 text-gray-500">中文优质资源</span>
                       </div>
                       <div>
                           <span class="block text-4xl font-bold text-indigo-600">8</span>
                           <span class="block mt-2 text-gray-500">大分类收录</span>
                       </div>
                   </div>
                   <div class="bg-gray-50 px-8 py-4 border-t border-gray-100">
                       <p class="text-center text-sm text-gray-500">
                           来源：阿里云、腾讯云、DigitalOcean、Hostinger、IBM、Codecademy、B站、博客园...
                       </p>
                   </div>
               </div>
           </div>
        </section>
    </main>

    <LandingFooter />
</body>
</html>
